rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function yeni() { return request.resource.data; }
    function eski() { return resource.data; }
    function shortStr(v, max) { return v is string && v.size() <= max; }
    function fYol(fid) { return /databases/$(database)/documents/satis_firmalar/$(fid); }
    function firma(fid) { return get(fYol(fid)).data; }
    function uye(fid) { return signedIn() && uid() in firma(fid).uyeler; }
    function yonetici(fid) { return signedIn() && uid() in firma(fid).yoneticiler; }
    function saha(fid) { return signedIn() && uid() in firma(fid).get('saha', []); }
    function gizli(fid) { return getAfter(/databases/$(database)/documents/satis_firmalar/$(fid)/gizli/kodlar).data; }
    function katilimKodu(fid) { return getAfter(/databases/$(database)/documents/satis_firmalar/$(fid)/katilim/$(uid())).data.kod; }
    function sadece(alanlar) { return yeni().diff(eski()).affectedKeys().hasOnly(alanlar); }

    match /satis_kullanicilar/{userId} {
      allow get: if signedIn();
      allow create, update: if signedIn() && uid() == userId
        && (!('ad' in yeni()) || shortStr(yeni().ad, 80))
        && (!('firmaId' in yeni()) || shortStr(yeni().firmaId, 64));
    }

    match /satis_kodlar/{kod} {
      allow get: if signedIn();
      allow create: if signedIn()
        && uid() in getAfter(fYol(yeni().firmaId)).data.yoneticiler
        && (gizli(yeni().firmaId).get('kod', '') == kod || gizli(yeni().firmaId).get('sahaKod', '') == kod);
      allow delete: if yonetici(eski().firmaId);
    }

    match /satis_firmalar/{fid} {
      allow get: if signedIn() && (uid() in eski().uyeler || uid() in eski().get('saha', []));
      allow create: if signedIn() && yeni().sahip == uid()
        && yeni().uyeler == [uid()] && yeni().yoneticiler == [uid()]
        && yeni().get('saha', []) == [] && yeni().sayac == 0
        && !('kod' in yeni()) && shortStr(yeni().ad, 40);
      allow update: if signedIn() && (
        (uid() in eski().yoneticiler && yeni().sahip == eski().sahip
          && eski().sahip in yeni().uyeler && eski().sahip in yeni().yoneticiler
          && yeni().yoneticiler.hasOnly(yeni().uyeler) && yeni().sayac >= eski().sayac
          && !('kod' in yeni()) && !('katilKod' in yeni()) && shortStr(yeni().ad, 40))
        || ((uid() in eski().uyeler || uid() in eski().get('saha', []))
          && sadece(['sayac']) && yeni().sayac == eski().sayac + 1)
        || (!(uid() in eski().uyeler) && sadece(['uyeler'])
          && yeni().uyeler.toSet() == eski().uyeler.toSet().union([uid()].toSet())
          && katilimKodu(fid) == gizli(fid).kod)
        || (!(uid() in eski().get('saha', [])) && sadece(['saha'])
          && yeni().saha.toSet() == eski().get('saha', []).toSet().union([uid()].toSet())
          && katilimKodu(fid) == gizli(fid).sahaKod));
      allow delete: if signedIn() && uid() == eski().sahip;

      match /gizli/{belge} {
        allow read: if yonetici(fid);
        allow write: if signedIn() && uid() in getAfter(fYol(fid)).data.yoneticiler;
      }

      match /katilim/{userId} {
        allow create, update: if signedIn() && uid() == userId
          && shortStr(yeni().kod, 16) && yeni().kod.size() >= 6;
        allow read: if yonetici(fid);
      }

      match /siparisler/{sid} {
        function gecerli(d) {
          return shortStr(d.musteri, 80) && d.musteri.size() > 0
            && shortStr(d.urun, 60) && d.urun.size() > 0
            && d.miktar is number && d.miktar > 0 && shortStr(d.birim, 16)
            && (!('not' in d) || shortStr(d.not, 500))
            && (!('araci' in d) || shortStr(d.araci, 80))
            && (d.get('fiyat', null) == null || (d.fiyat is number && d.fiyat >= 0))
            && d.tahsilatlar is list && d.tahsilatlar.size() <= 200;
        }
        function benim() { return eski().olusturan == uid() || uid() in eski().get('gorenler', []); }
        allow read: if uye(fid) || (saha(fid) && benim());
        allow create: if (uye(fid) || (saha(fid) && yeni().get('gorenler', []) == []))
          && yeni().olusturan == uid() && gecerli(yeni());
        allow update: if (uye(fid) || (saha(fid) && benim()
            && yeni().get('gorenler', []) == eski().get('gorenler', [])))
          && yeni().olusturan == eski().olusturan && yeni().no == eski().no
          && gecerli(yeni());
        allow delete: if yonetici(fid) || (uye(fid) && eski().olusturan == uid());
      }

      match /satis_hareketleri/{hid} {
        allow read: if uye(fid);
        allow create: if uye(fid) || saha(fid);
        allow delete: if yonetici(fid);
      }
    }

    match /satis_hareketleri/{hid} {
      allow read: if uye(eski().firmaId);
      allow create: if uye(yeni().firmaId) || saha(yeni().firmaId);
      allow delete: if yonetici(eski().firmaId);
    }
  }
}
